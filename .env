# Support RCA — Environment Variables
# Copy to .env and fill in values

# ── Azure AI Foundry (recommended) ────────────────────────────────────────────
MICROSOFT_FOUNDRY_PROJECT_ENDPOINT='https://your-foundry-project-resource.services.ai.azure.com/api/projects/sujoy_saha_4958'
MICROSOFT_FOUNDRY_DEPLOYMENT='gpt-4o'

# ── Azure OpenAI (fallback) ───────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Public OpenAI (dev only) ──────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Output ────────────────────────────────────────────────────────────────────
# Directory where RCA markdown reports are saved
RCA_OUTPUT_DIR=./reports

# Keep agents in Foundry portal after run (useful for debugging)
RCA_CLEANUP_AGENTS=true
